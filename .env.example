# Copia este archivo como .env y rellena los valores reales.
# .env está en .gitignore y nunca debe subirse al repositorio.

TZ=Europe/Madrid

# Pi-hole
PIHOLE_PASSWORD=

# Vaultwarden
VAULTWARDEN_DOMAIN=
SIGNUPS_ALLOWED=false
VAULTWARDEN_ADMIN_TOKEN=

# SMTP (usado por Vaultwarden y Grafana para enviar correo)
SMTP_USERNAME=
SMTP_PASSWORD=

# Grafana (admin fijo -- sin esto, un volumen grafana_data recreado desde
# cero queda con las credenciales por defecto admin/admin)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Tailscale
TS_AUTHKEY=

# Webhook de backups
BACKUP_TRIGGER_TOKEN=

# Bot de Telegram. TELEGRAM_CLIENT_ID es el chat_id al que van las alertas
# de Grafana, el informe diario, y donde vive Sebastián (el agente
# conversacional) -- apunta al grupo "Home" con varios miembros de la casa,
# no a un chat personal.
TELEGRAM_API_TOKEN=
TELEGRAM_CLIENT_ID=

# API key de Anthropic (usada por la integracion Anthropic de Home Assistant, se
# introduce en su UI al anadir la integracion, no se lee de este fichero)
ANTHROPIC_API_KEY=
