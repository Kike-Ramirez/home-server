# Copia este archivo como .env y rellena los valores reales.
# .env está en .gitignore y nunca debe subirse al repositorio.

TZ=Europe/Madrid

# Pi-hole
PIHOLE_PASSWORD=

# Vaultwarden
VAULTWARDEN_DOMAIN=
SIGNUPS_ALLOWED=false
VAULTWARDEN_ADMIN_TOKEN=

# SMTP (usado por Vaultwarden y Grafana para enviar correo)
SMTP_USERNAME=
SMTP_PASSWORD=

# Tailscale
TS_AUTHKEY=

# Webhook de backups
BACKUP_TRIGGER_TOKEN=
