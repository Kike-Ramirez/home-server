      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device=\"enp2s0\"}[5m])",
          "legendFormat": "rx",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device=\"enp2s0\"}[5m])",
          "legendFormat": "tx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 26,
      "type": "row",
      "title": "Presencia en la red (qui\u00e9n responde ahora mismo)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 27,
      "type": "table",
      "title": "Qui\u00e9n responde en la red ahora mismo (Nmap Tracker)",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "homeassistant_device_tracker_state{domain=\"device_tracker\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "domain": true,
              "instance": true,
              "job": true,
              "entity": true
            },
            "indexByName": {
              "friendly_name": 0,
              "Value": 1
            },
            "renameByName": {
              "friendly_name": "Nombre",
              "Value": "Estado"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Nombre",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "En casa",
                  "color": "green"
                },
                "0": {
                  "text": "Fuera",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    }
