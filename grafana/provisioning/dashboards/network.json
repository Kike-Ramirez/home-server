{
  "uid": "network-overview",
  "title": "Network",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 11,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 22,
      "type": "row",
      "title": "Resumen",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Internet",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"1.1.1.1\"}",
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "En linea"
                },
                "0": {
                  "text": "Caido"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "#FF453A",
                "value": null
              },
              {
                "color": "#30D158",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latencia a Internet",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{instance=\"1.1.1.1\"} * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              {
                "color": "#30D158",
                "value": null
              },
              {
                "color": "#FF9F0A",
                "value": 60
              },
              {
                "color": "#FF453A",
                "value": 150
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Bajada",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.speedtest_descarga\"}[35m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Subida",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "last_over_time(homeassistant_sensor_data_rate_mbit_per_s{entity=\"sensor.speedtest_subida\"}[35m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "% Bloqueado",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "pihole_dns_percent_blocked",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "#0A84FF",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Dispositivos activos (24h)",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "network_devices_active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Dispositivos en la LAN (qui\u00e9n pregunta por DNS)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "table",
      "title": "Qui\u00e9n ha preguntado por DNS en las \u00faltimas 24h (Pi-hole)",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "network_device_last_seen_minutes",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "ip": 1,
              "mac": 2,
              "vendor": 3,
              "Value": 4
            },
            "renameByName": {
              "name": "Nombre",
              "ip": "IP",
              "mac": "MAC",
              "vendor": "Fabricante",
              "Value": "Hace (min)"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Hace (min)",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hace (min)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 23,
      "type": "row",
      "title": "Diagnostico y detalle",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      }
    },
