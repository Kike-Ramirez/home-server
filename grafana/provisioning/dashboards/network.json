                "0": {
                  "text": "Error"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "#FF453A",
                "value": null
              },
              {
                "color": "#30D158",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Consultas DNS totales / bloqueadas",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "targets": [
        {
          "expr": "pihole_dns_queries_total",
          "legendFormat": "totales",
          "refId": "A"
        },
        {
          "expr": "pihole_dns_queries_blocked_total",
          "legendFormat": "bloqueadas",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
